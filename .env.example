# Copy this file to .env and adjust as needed.

# Local MongoDB (default if you don't set this at all):
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce-app

# Or, a free MongoDB Atlas cluster (get this string from Atlas -> Connect -> Drivers):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce-app

# Session cookie secret -- change this to any long random string in production
SESSION_SECRET=dev-secret-change-me-in-production

# Port the server listens on
PORT=3000
